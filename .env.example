# Copy to .env. This file holds CONFIGURATION ONLY.
#
# Secrets belong in the OS credential store, not here:
#
#     python -m plaid_lab secrets set client_id
#     python -m plaid_lab secrets set secret --env production
#     python -m plaid_lab secrets status
#
# PLAID_CLIENT_ID and PLAID_SECRET are still read from .env as a fallback when
# the credential store has no entry, which keeps a fresh checkout working. But
# .env is a filename infostealers target by pattern, so do not leave live
# credentials in it.

# sandbox | production  (Plaid retired 'development' in 2024)
PLAID_ENV=sandbox
