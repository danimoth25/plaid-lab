# Copy to .env and fill in. Keys: https://dashboard.plaid.com/developers/keys
# .env is gitignored; .env.example is not, so never put real values here.

PLAID_CLIENT_ID=
# The secret must match PLAID_ENV. Plaid issues a separate secret per
# environment against the same client_id; a mismatched pair returns
# INVALID_API_KEYS, which looks like a bad client_id and is not.
PLAID_SECRET=

# sandbox | production  (Plaid retired 'development' in 2024)
PLAID_ENV=sandbox
