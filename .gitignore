# Virtual environment
.venv/

# Python build / cache artifacts
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Secrets. .env holds the Plaid client_id and secret.
.env
*.env
.env.*
!.env.example

# items.json holds access_tokens. In Production each one is a live credential
# to a real bank account; it never goes in the repo.
items.json

# Local working notes carrying account specifics.
*-private.md

# Generated exports.
exports/

# --- Financial source data. NEVER COMMIT. ---------------------------------
# This repo is PUBLIC. Everything below carries real statements, balances,
# account numbers, merchant history, or third-party names. The rules are
# deliberately broad: a missed entry here is an irreversible disclosure, and
# `git add -A` is used routinely in this repo.
*.zip
*.csv
*.pdf
*.xlsx
*.xls
*.ofx
*.qfx
budget/
data/
provided_files/
statements/
